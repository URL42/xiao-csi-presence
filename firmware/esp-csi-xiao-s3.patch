+/**
+ * @brief Board LED abstraction.
+ *
+ * Upstream assumes an addressable WS2812, which is right for the Espressif
+ * DevKits but wrong for the Seeed XIAO ESP32S3: that board has a single plain
+ * user LED on GPIO21, wired active low, and does not break out GPIO38 at all.
+ * Driving RMT on GPIO38 there is harmless but gives no feedback whatsoever.
+ *
+ * Set BOARD_XIAO_ESP32S3 to 0 to get the stock WS2812 behaviour back.
+ */
+#define BOARD_XIAO_ESP32S3 1
+
+#if BOARD_XIAO_ESP32S3
+
+#define XIAO_USER_LED_GPIO 21
+
+/**< Colour is collapsed to on/off: any non-black value lights the LED. */
+static inline void board_led_set(uint8_t r, uint8_t g, uint8_t b)
+{
+    gpio_set_level(XIAO_USER_LED_GPIO, (r || g || b) ? 0 : 1);   /**< active low */
+}
+
+static inline void board_led_refresh(void) { }
+
+static esp_err_t board_led_init(void)
+{
+    gpio_config_t led_cfg = {
+        .pin_bit_mask = 1ULL << XIAO_USER_LED_GPIO,
+        .mode         = GPIO_MODE_OUTPUT,
+        .pull_up_en   = GPIO_PULLUP_DISABLE,
+        .pull_down_en = GPIO_PULLDOWN_DISABLE,
+        .intr_type    = GPIO_INTR_DISABLE,
+    };
+    ESP_ERROR_CHECK(gpio_config(&led_cfg));
+    board_led_set(0, 0, 0);
+    return ESP_OK;
+}
+
+#else /* stock WS2812 boards */
+
 static led_strip_handle_t led_strip;
 #if CONFIG_IDF_TARGET_ESP32C5
 #define WS2812_GPIO 27
@@ -50,6 +93,25 @@ static led_strip_handle_t led_strip;
 #define WS2812_GPIO 8
 #else
 #define WS2812_GPIO 4
+#endif
+
+static inline void board_led_set(uint8_t r, uint8_t g, uint8_t b)
+{
+    led_strip_set_pixel(led_strip, 0, r, g, b);
+}
+
+static inline void board_led_refresh(void)
+{
+    led_strip_refresh(led_strip);
+}
+
+esp_err_t ws2812_led_init(void);
+
+static inline esp_err_t board_led_init(void)
+{
+    return ws2812_led_init();
+}
