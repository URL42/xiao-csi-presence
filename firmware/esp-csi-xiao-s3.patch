+/**
+ * @brief Manual control of the receiver gain used for CSI.
+ *
+ * Measured on this board: agc_gain took 18 distinct values over a session
+ * while RSSI held steady at -46 dBm, and mean CSI frame amplitude tracked
+ * it inversely (agc 40 -> 11.0, agc 45 -> 5.9). That ~2x swing is a
+ * receiver artefact, not the room, and it lands directly in
+ * waveform_wander, which is what makes presence-while-motionless drift.
+ * Pinning the gain removes the noise source instead of compensating it.
+ */
+static struct {
+    struct arg_int *force_agc;
+    struct arg_int *force_fft;
+    struct arg_lit *automatic;
+    struct arg_lit *status;
+    struct arg_end *end;
+} gain_args;
+
+static int cmd_csi_gain(int argc, char **argv)
+{
+    if (arg_parse(argc, argv, (void **) &gain_args) != ESP_OK) {
+        arg_print_errors(stderr, gain_args.end, argv[0]);
+        return ESP_FAIL;
+    }
+
+#if WIFI_CSI_PHY_GAIN_ENABLE
+    if (gain_args.automatic->count) {
+        esp_csi_gain_ctrl_reset_rx_gain_baseline();
+        ESP_LOGI(TAG, "GAIN: reset to automatic, baseline cleared");
+    }
+
+    if (gain_args.force_agc->count && gain_args.force_fft->count) {
+        esp_err_t err = esp_csi_gain_ctrl_set_rx_force_gain((uint8_t)gain_args.force_agc->ival[0],
+                                                            (int8_t)gain_args.force_fft->ival[0]);
+        ESP_LOGI(TAG, "GAIN: force agc=%d fft=%d -> %s",
+                 gain_args.force_agc->ival[0], gain_args.force_fft->ival[0], esp_err_to_name(err));
+    } else if (gain_args.force_agc->count || gain_args.force_fft->count) {
+        ESP_LOGW(TAG, "GAIN: --force_agc and --force_fft must be given together");
+    }
+
+    if (gain_args.status->count) {
+        static const char *state_name[] = { "COLLECT", "READY", "FORCE" };
+        uint8_t agc = 0;
+        int8_t fft = 0;
+        rx_gain_status_t st = esp_csi_gain_ctrl_get_gain_status();
+        esp_csi_gain_ctrl_get_rx_gain_baseline(&agc, &fft);
+        ESP_LOGI(TAG, "GAIN: status=%s baseline_agc=%d baseline_fft=%d",
+                 (st <= RX_GAIN_FORCE) ? state_name[st] : "UNKNOWN", agc, fft);
+    }
+#else
+    ESP_LOGW(TAG, "GAIN: rx gain control is not available for this target");
+#endif
+
+    return ESP_OK;
+}
+
+void cmd_register_csi_gain(void)
+{
+    gain_args.force_agc  = arg_int0(NULL, "force_agc", "<0~63>", "Pin the AGC gain to a fixed value");
+    gain_args.force_fft  = arg_int0(NULL, "force_fft", "<-128~127>", "Pin the FFT gain to a fixed value");
+    gain_args.automatic  = arg_lit0(NULL, "automatic", "Return to automatic gain and clear the baseline");
+    gain_args.status     = arg_lit0(NULL, "status", "Print gain status and the learned baseline");
+    gain_args.end        = arg_end(4);
+
+    const esp_console_cmd_t gain_cmd = {
+        .command = "csi_gain",
+        .help = "Receiver gain control for CSI stability",
+        .hint = NULL,
+        .func = &cmd_csi_gain,
+        .argtable = &gain_args
+    };
+
+    ESP_ERROR_CHECK(esp_console_cmd_register(&gain_cmd));
+}
